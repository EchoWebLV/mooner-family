{
  "name": "mooner-web",
  "private": true,
  "type": "module",
  "description": "Mooner website: launch a presale, join one, get your SOL back. The Mooner server serves the build (web/dist), and the simulation (sim/, built into dist/sim) at /sim.",
  "scripts": {
    "dev": "vite",
    "dev:sim": "vite --config sim/vite.config.js",
    "build": "vite build && vite build --config sim/vite.config.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@privy-io/react-auth": "3.45.0",
    "@solana-program/memo": "0.15.0",
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana/kit": "8.3.0",
    "@solana/web3.js": "1.99.0",
    "buffer": "6.0.3",
    "immer": "11.1.18",
    "lightweight-charts": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.1"
  }
}
