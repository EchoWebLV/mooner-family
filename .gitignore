# secrets: never commit keys or env files
.env
.env.*
*keypair*.json
id.json
# the server's database holds mint secret keys
*.db
*.db-journal

# build output
**/target/
node_modules/
programs/presale/litesvm/fixtures/*.so

# engine canary state and keys (local and devnet)
engine/.canary/

# mainnet keys and deployment record (engine/scripts/mainnet.js)
engine/.mainnet/
engine/.rehearsal/

# waitlist signups (site/server.mjs): emails, X accounts, wallets
site/.data/
# the waitlist's join bundle, built by site/tools/build-join.mjs (deploy/railway.sh site runs it)
site/assets/join/

# visual brainstorming companion
.superpowers/

# bubble test (engine/scripts/bubbletest.js): session keys and run state
engine/.bubble/

# local Claude Code state: preview config, screenshots, worktrees
.claude/

# rendered video and audio: too big for GitHub (several files over 100 MB)
docs/superpowers/**/*.mp4
docs/superpowers/**/*.mp3
