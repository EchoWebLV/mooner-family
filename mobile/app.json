{
  "expo": {
    "name": "Mooner",
    "slug": "mooner",
    "scheme": "mooner",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07080b",
    "android": {
      "package": "family.mooner.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.mooner.family",
              "pathPrefix": "/presale/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "./plugins/withReleaseSigning",
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#0d0e12",
            "cropToolbarIconColor": "#f3f4f6",
            "cropToolbarActionTextColor": "#f3f4f6",
            "cropBackButtonIconColor": "#f3f4f6",
            "cropBackgroundColor": "#07080b"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#0d0e12",
              "cropToolbarIconColor": "#f3f4f6",
              "cropToolbarActionTextColor": "#f3f4f6",
              "cropBackButtonIconColor": "#f3f4f6",
              "cropBackgroundColor": "#07080b"
            }
          }
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "backgroundColor": "#07080b"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
